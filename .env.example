# ═══════════════════════════════════════════════════════════════════════════════
# Bug Hunter AI — Environment Configuration
# Copy this file to .env and customize it.
# Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false

# ── Ollama AI ─────────────────────────────────────────────────────────────────
# URL where Ollama is listening
OLLAMA_HOST=http://127.0.0.1:11434

# The Ollama model to use for analysis.
# Run `ollama list` to see models installed on your system.
# Recommended: llama3, llama3.1, llama3.2, mistral, gemma2
OLLAMA_MODEL=llama3

# Timeout for Ollama requests (seconds)
OLLAMA_TIMEOUT=120

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite database stored locally.  Use absolute path or ~ expansion.
DATABASE_URL=sqlite:////Users/YOUR_USERNAME/.bug-hunter/bug_hunter.db

# ── Logging ───────────────────────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location (leave blank to log to stdout only)
LOG_FILE=~/.bug-hunter/bug_hunter.log

# ── Security Behavior ─────────────────────────────────────────────────────────
# Always require authorization confirmation before scanning
REQUIRE_AUTHORIZATION=true

# Never automatically apply file patches without explicit user approval
AUTO_APPLY_FIXES=false

# ── Scanner Defaults ──────────────────────────────────────────────────────────
# Default nmap scan flags (safe defaults — no aggressive/OS detection)
NMAP_DEFAULT_FLAGS=-sV --open

# Max scan duration in seconds (0 = no limit)
SCAN_TIMEOUT=300
